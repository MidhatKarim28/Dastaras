# Postgres (docker compose up -d db)
DATABASE_URL=postgres://dastaras:dastaras@localhost:5432/dastaras

# Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
# Public origin the browser uses (the web app proxies /api to the API)
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# API server
PORT=8787
# Where the web app reaches the API (server-side + rewrites)
API_URL=http://localhost:8787
